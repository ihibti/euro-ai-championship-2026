# Copy to .env (gitignored) and fill locally. Never commit real values.
# Nothing in this repo reads .env automatically; export variables yourself.

# Hugging Face access token (only if a gated model/dataset is required)
HF_TOKEN=
# Where Hugging Face caches models/datasets (on JURECA point this into $PROJECT, not $HOME)
HF_HOME=

# Experiment tracking (optional; offline JSONL logging is the default)
WANDB_API_KEY=
WANDB_MODE=

# Project paths (optional overrides)
EUROAI_DATA_DIR=
EUROAI_OUTPUT_DIR=

# Leaderboard / submission endpoint details (TBD by organizers)
SUBMISSION_URL=
SUBMISSION_TOKEN=
