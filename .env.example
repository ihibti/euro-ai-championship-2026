# Template only. Never put real values in this repo.
# The real file is ~/.config/euroai/.env, outside every checkout, with mode 600:
#   chmod 600 ~/.config/euroai/.env
# The scripts read each variable from the process environment first, then from that file.
# EUROAI_SECRETS_FILE overrides the file's path.

# Team API key for the leaderboard server (submissions and model-equality queries)
HACKATHON_API_KEY=
# Hugging Face read token; its account must be approved for the gated watermark dataset
HF_TOKEN=

# Optional, not secret: where Hugging Face caches models and datasets (on JURECA, under $SCRATCH or the team folder)
HF_HOME=

# Optional experiment tracking (offline JSONL logging is the default)
WANDB_API_KEY=
WANDB_MODE=

# Optional project path overrides
EUROAI_DATA_DIR=
EUROAI_OUTPUT_DIR=
